# Credenciales del panel admin (/admin)
ADMIN_USER=admin
ADMIN_PASS=cambia_esta_contrasena

# Secreto para firmar las cookies de sesión (JWT).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=genera_una_clave_larga_y_aleatoria

# Entorno
NODE_ENV=development

# Nota: los enlaces y contadores se guardan en Netlify Blobs, que se activa
# solo al desplegar en Netlify. No hace falta ninguna clave ni servicio extra.
# En desarrollo local los datos van a la carpeta .data/ (ignorada por git).
